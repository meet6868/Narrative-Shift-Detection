# Copy this file to .env and fill values.
# .env is ignored by git via .gitignore.

# Hugging Face token (used by TCL/TCL_Pipeline_1.ipynb upload/download helpers)
HF_TOKEN=
# Optional alias used by some tools/libraries
HUGGINGFACEHUB_API_TOKEN=

# Optional GitHub personal access token (if using token-based git auth)
GITHUB_TOKEN=

# Optional default identity for local git commits
GIT_USER_NAME=
GIT_USER_EMAIL=
